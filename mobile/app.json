{
  "expo": {
    "name": "Relay",
    "slug": "relay-mobile",
    "version": "0.1.0",
    "scheme": "relay-mobile",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-asset"
    ]
  }
}
